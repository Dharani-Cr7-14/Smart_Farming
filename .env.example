# Models and data directories (defaults to project root models/ and data/ directories)
# MODELS_DIR=../../models
# DATA_DIR=../../data

# Ollama settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Separate frontend deployment settings
FRONTEND_ORIGINS=http://localhost:8080
VITE_API_URL=http://localhost:8000

# Use a long random value outside local development.
COOKIE_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
USE_MOCK_MODELS=false
